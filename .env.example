# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used in server-side admin operations (never exposed to the client).
# Project Settings > API > service_role — keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (optional, free tier) — for contact form emails if not using Netlify Forms
RESEND_API_KEY=

# Groq — powers the "Ask AI" widget (about-me Q&A + project explainer).
# Get a free key at console.groq.com. Server-only — never exposed to the browser.
GROQ_API_KEY=
